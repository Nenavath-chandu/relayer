# ================================================================
#  Reality Layer — Environment Variables
#  Copy this file to .env and fill in your real keys.
#  NEVER commit .env to GitHub — it's already in .gitignore
# ================================================================

# ─── REQUIRED ───────────────────────────────────────────────────
# 1. Google Gemini API Key  (Powers all AI fact-checking)
#    Get it FREE at: https://aistudio.google.com/app/apikey
#    No credit card needed.
GEMINI_API_KEY=your_gemini_key_here

# ─── OPTIONAL (makes the app fully live) ────────────────────────
# 2. NewsAPI Key  (Powers the real news feed on Home screen)
#    Get it FREE at: https://newsapi.org/register
#    Free tier: 100 requests/day — enough for demos and recruiters.
NEWS_API_KEY=your_newsapi_key_here

# 3. Google Fact Check Tools API Key  (Cross-references journalist databases)
#    Get it FREE at: https://console.cloud.google.com
#    Steps: Create project → Enable "Fact Check Tools API" → Create API Key
#    100% free, no billing required.
GOOGLE_FACTCHECK_KEY=your_google_factcheck_key_here
